# Environment Configuration
PROJECT_NAME="MY PARISH MY PROUD - Community Development & Parish Management Platform"
API_V1_STR="/api/v1"
SECRET_KEY="super-secret-parish-key-change-in-production-2026"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database Configuration (SQLite default for local, PostgreSQL supported)
DATABASE_URL="sqlite:///./parish.db"
# DATABASE_URL="postgresql://postgres:password@localhost:5432/parish_db"

# Object Storage Configuration (Optional S3/Cloud Storage)
STORAGE_TYPE="local"
S3_BUCKET_NAME="parish-documents"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""

# Email Notification Configuration (Optional SMTP)
SMTP_SERVER="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="notifications@parish.org"
SMTP_PASSWORD=""

# Payment Gateway Configuration (Optional Stripe/Razorpay)
STRIPE_PUBLIC_KEY="pk_test_sample"
STRIPE_SECRET_KEY="sk_test_sample"
